{
  "name": "upscayl-next-installer",
  "version": "1.2.3",
  "private": true,
  "description": "Modern downloader and installer for Upscayl-Next",
  "author": "Upscayl-Next contributors",
  "license": "AGPL-3.0",
  "main": "main.js",
  "build": {
    "appId": "org.upscaylnext.Installer",
    "productName": "Upscayl-Next Installer",
    "artifactName": "Upscayl-Next-Installer-${version}.${ext}",
    "electronVersion": "33.2.1",
    "electronDist": "../node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "../build/icon.png"
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  }
}
