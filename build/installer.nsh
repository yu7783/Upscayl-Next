; Custom NSIS UI for Upscayl-Next.
; electron-builder includes this file via nsis.include.
; The welcome page plays an animated AVI banner generated by
; scripts/generate-installer-assets.ps1.

!include "MUI2.nsh"
!include "nsDialogs.nsh"
!include "LogicLib.nsh"

!ifndef BUILD_UNINSTALLER
Var WelcomeDialog
Var WelcomeAnim

!macro customWelcomePage
  Page custom WelcomePageCreate WelcomePageLeave
!macroend

Function WelcomePageCreate
  !insertmacro MUI_HEADER_TEXT "Welcome to Upscayl-Next" "AI-powered image and video upscaling"

  nsDialogs::Create 1018
  Pop $WelcomeDialog
  ${If} $WelcomeDialog == error
    Abort
  ${EndIf}

  ; Animated banner (280x60). NSD_Anim_Play loops the AVI silently.
  ${NSD_CreateAnimation} 0 0 280 60 ""
  Pop $WelcomeAnim

  InitPluginsDir
  SetOutPath "$PLUGINSDIR\upscayl-installer"
  File /oname=$PLUGINSDIR\upscayl-installer\banner.avi "${BUILD_RESOURCES_DIR}\anim\banner.avi"
  ${NSD_Anim_OpenFile} $WelcomeAnim "$PLUGINSDIR\upscayl-installer\banner.avi"
  ${NSD_Anim_Play} $WelcomeAnim

  ${NSD_CreateLabel} 0 68 280 14 "Upscayl-Next is a free and open-source AI upscaler."
  Pop $0
  ${NSD_CreateLabel} 0 84 280 28 "This wizard installs the app, models, and the Vulkan runtime.$\r$\nClick Next to choose an installation folder."
  Pop $0

  nsDialogs::Show
FunctionEnd

Function WelcomePageLeave
  ; Stop playback before the page is destroyed.
  ${NSD_Anim_Stop} $WelcomeAnim
FunctionEnd
!endif
